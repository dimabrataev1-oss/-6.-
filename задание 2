# Считываем номер кармана
n = int(input())

# Проверяем, входит ли число в допустимый диапазон от 0 до 36
if n < 0 or n > 36:
    print("ошибка ввода")
elif n == 0:
    print("зеленый")
# Карманы 1-10 и 19-28: нечетные — красные, четные — черные
elif (1 <= n <= 10) or (19 <= n <= 28):
    if n % 2 != 0:
        print("красный")
    else:
        print("черный")
# Карманы 11-18 и 29-36: нечетные — черные, четные — красные
elif (11 <= n <= 18) or (29 <= n <= 36):
    if n % 2 != 0:
        print("черный")
    else:
        print("красный")
