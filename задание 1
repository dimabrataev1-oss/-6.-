
# Ввод входных данных с клавиатуры
temp = float(input("Введите температуру (°C): "))
pressure = int(input("Введите верхнее давление: "))
pulse = int(input("Введите пульс (уд/мин): "))

# Проверка на критическое отклонение (Требуется врач)
if temp < 35 or temp > 38 or pressure < 105 or pressure > 140 or pulse < 55 or pulse > 110:
    print("Результат анализа: Требуется врач")

# Проверка на легкое недомогание
elif (35 <= temp < 36 or 37 < temp <= 38) or \
     (105 <= pressure < 110 or 130 < pressure <= 140) or \
     (55 <= pulse < 60 or 100 < pulse <= 110):
    print("Результат анализа: Легкое недомогание")

# Если всё в норме
else:
    print("Результат анализа: Нормальное состояние")
